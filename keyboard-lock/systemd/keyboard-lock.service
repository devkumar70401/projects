[Unit]
Description=Keyboard-Only Lock Utility for Linux
Documentation=https://github.com/dev/keyboard-lock
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/keyboard-lock --verbose
ExecStop=/usr/local/bin/keyboard-lock --stop
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
